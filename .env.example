# ------------------------------------------------------------------
# NautSpace International Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth / 2FA
AUTH_TOTP_ISSUER=NautSpaceInternational
AUTH_SESSION_SECRET=

# Web3 / Hybrid DAO Governance (mock treasury + proposal voting)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DAO_CHAIN_ID=11155111
NEXT_PUBLIC_DAO_TREASURY_ADDRESS=

# Site
NEXT_PUBLIC_SITE_URL=https://orbitspacesafari.co.ke
NEXT_PUBLIC_ORG_NAME="Space Exploration in Africa"

# Transactional email (partnership inquiries, application receipts).
# Free at resend.com until RESEND_FROM_EMAIL is on a verified domain,
# leave it as the default below (Resend's shared sending address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=NautSpace International <onboarding@resend.dev>
CONTACT_INBOX_EMAIL=winters.shadrack@gmail.com
